#!/usr/bin/env python3
"""Controlled stand-in for cursor-sdk-bridge: the Connect JSON calls the Node makes.

FAKE_BRIDGE_STARTUP_MS delays the discovery line; FAKE_BRIDGE_LOG gets one pid per start.
A prompt containing "hang" never answers its Send. Standard library only.
"""
import json
import os
import sys
import threading
import time
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


def argument(name):
    return sys.argv[sys.argv.index(name) + 1]


if not os.environ.get("CURSOR_API_KEY") or os.environ.get("CURSOR_SDK_CLIENT_LANGUAGE") != "rust":
    sys.exit(3)
token = uuid.uuid4().hex
token_file = os.path.join(argument("--state-root"), "fake-bridge-token")
descriptor = os.open(token_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
os.write(descriptor, token.encode())
os.close(descriptor)
os.chmod(token_file, 0o600)
if os.environ.get("FAKE_BRIDGE_LOG"):
    with open(os.environ["FAKE_BRIDGE_LOG"], "a") as log:
        log.write(f"{os.getpid()}\n")
runs = {}


def frame(flags, message):
    body = json.dumps(message).encode()
    return bytes([flags]) + len(body).to_bytes(4, "big") + body


def finished(agent, run, text):
    status = "RUN_LIFECYCLE_STATUS_FINISHED"
    inner = {"agentId": agent, "runId": run, "status": status, "result": text}
    return {"result": {"agentId": agent, "runId": run, "status": status, "result": inner}}


class Bridge(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *_):
        pass

    def answer(self, status, body, content_type="application/json"):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        request = self.rfile.read(int(self.headers.get("Content-Length", "0")))
        if self.headers.get("Authorization") != f"Bearer {token}":
            return self.answer(401, b"{}")
        method = self.path.rsplit("/", 1)[-1]
        if method == "Send":
            message = json.loads(request[5:])
            agent, run = message["agentId"], "run-" + uuid.uuid4().hex
            runs[run] = agent
            text = message["message"]["text"]
            if "hang" in text:
                time.sleep(3600)
            stream = (frame(0, finished(agent, run, "done: " + text))
                      + frame(0, {"done": {"agentId": agent, "runId": run}}) + frame(2, {}))
            return self.answer(200, stream, "application/connect+json")
        body = json.loads(request or b"{}")
        replies = {
            "Ping": {"message": "pong"},
            "GetVersion": {"protocolVersion": "sdk.v1"},
            "CreateAgent": {"agentId": "agent-" + uuid.uuid4().hex},
            "ResumeAgent": {"agentId": body.get("agentId")},
            "GetRun": {"run": {"agentId": runs.get(body.get("runId")), "runId": body.get("runId"),
                               "status": "RUN_LIFECYCLE_STATUS_CANCELLED"}},
        }
        if method == "Shutdown":
            threading.Timer(0.1, os._exit, [0]).start()
        self.answer(200, json.dumps(replies.get(method, {})).encode())


server = ThreadingHTTPServer(("127.0.0.1", 0), Bridge)
server.daemon_threads = True
time.sleep(int(os.environ.get("FAKE_BRIDGE_STARTUP_MS", "0")) / 1000)
discovery = {"schemaVersion": 1, "transport": "tcp", "protocol": "connect",
             "url": f"http://127.0.0.1:{server.server_address[1]}", "authTokenFile": token_file}
print("cursor-sdk-bridge ready " + json.dumps(discovery), file=sys.stderr, flush=True)
server.serve_forever()
