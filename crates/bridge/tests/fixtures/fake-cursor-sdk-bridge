#!/usr/bin/env python3
"""Controlled stand-in for cursor-sdk-bridge: the Connect JSON calls the Node makes.

FAKE_BRIDGE_STARTUP_MS delays the discovery line; FAKE_BRIDGE_LOG gets one pid per start.
A prompt containing "hang" never answers its Send. Standard library only.
"""
import json
import os
import sys
import threading
import time
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


def startup_phase(name):
    print("fake-cursor-sdk-bridge phase " + name, file=sys.stderr, flush=True)


startup_phase("python-started")


def append_observation(path, value):
    """One record is one kernel append, including concurrent Windows fixture processes."""
    if not path:
        return
    data = (value + "\n").encode("utf-8")
    if os.name != "nt":
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        try:
            if os.write(descriptor, data) != len(data):
                raise OSError("incomplete observation append")
        finally:
            os.close(descriptor)
        return
    import ctypes
    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
    kernel.CreateFileW.argtypes = [ctypes.c_wchar_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_void_p]
    kernel.CreateFileW.restype = ctypes.c_void_p
    kernel.WriteFile.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ctypes.c_ulong), ctypes.c_void_p]
    kernel.CloseHandle.argtypes = [ctypes.c_void_p]
    # FILE_APPEND_DATA without FILE_WRITE_DATA makes the kernel select the end atomically.
    handle = kernel.CreateFileW(path, 0x0004, 0x0007, None, 4, 0x80, None)
    if handle == ctypes.c_void_p(-1).value:
        raise ctypes.WinError(ctypes.get_last_error())
    try:
        written = ctypes.c_ulong()
        buffer = ctypes.create_string_buffer(data)
        if not kernel.WriteFile(handle, buffer, len(data), ctypes.byref(written), None):
            raise ctypes.WinError(ctypes.get_last_error())
        if written.value != len(data):
            raise OSError("incomplete observation append")
    finally:
        kernel.CloseHandle(handle)


def argument(name):
    return sys.argv[sys.argv.index(name) + 1]


def restrict_windows_private_file(path):
    """Protected owner-only DACL for the fake bridge token, without spawning PowerShell."""
    import ctypes
    from ctypes import wintypes

    advapi32 = ctypes.WinDLL("advapi32", use_last_error=True)
    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)

    class SID_AND_ATTRIBUTES(ctypes.Structure):
        _fields_ = [("Sid", wintypes.LPVOID), ("Attributes", wintypes.DWORD)]

    class TOKEN_USER(ctypes.Structure):
        _fields_ = [("User", SID_AND_ATTRIBUTES)]

    class TRUSTEE_W(ctypes.Structure):
        _fields_ = [
            ("pMultipleTrustee", wintypes.LPVOID),
            ("MultipleTrusteeOperation", wintypes.DWORD),
            ("TrusteeForm", wintypes.DWORD),
            ("TrusteeType", wintypes.DWORD),
            ("ptstrName", wintypes.LPVOID),
        ]

    class EXPLICIT_ACCESS_W(ctypes.Structure):
        _fields_ = [
            ("grfAccessPermissions", wintypes.DWORD),
            ("grfAccessMode", wintypes.DWORD),
            ("grfInheritance", wintypes.DWORD),
            ("Trustee", TRUSTEE_W),
        ]

    TOKEN_QUERY = 0x0008
    TokenUser = 1
    FILE_ALL_ACCESS = 0x001F01FF
    SET_ACCESS = 2
    NO_INHERITANCE = 0
    TRUSTEE_IS_SID = 0
    TRUSTEE_IS_USER = 1
    NO_MULTIPLE_TRUSTEE = 0
    SE_FILE_OBJECT = 1
    DACL_SECURITY_INFORMATION = 0x00000004
    PROTECTED_DACL_SECURITY_INFORMATION = 0x00008000
    ERROR_SUCCESS = 0
    ERROR_INSUFFICIENT_BUFFER = 122

    def check_bool(result):
        if not result:
            raise ctypes.WinError(ctypes.get_last_error()) from None

    def check_error(code):
        if code != ERROR_SUCCESS:
            raise ctypes.WinError(code) from None

    advapi32.OpenProcessToken.argtypes = [
        wintypes.HANDLE,
        wintypes.DWORD,
        ctypes.POINTER(wintypes.HANDLE),
    ]
    advapi32.OpenProcessToken.restype = wintypes.BOOL
    advapi32.GetTokenInformation.argtypes = [
        wintypes.HANDLE,
        wintypes.DWORD,
        wintypes.LPVOID,
        wintypes.DWORD,
        ctypes.POINTER(wintypes.DWORD),
    ]
    advapi32.GetTokenInformation.restype = wintypes.BOOL
    advapi32.SetEntriesInAclW.argtypes = [
        wintypes.ULONG,
        ctypes.POINTER(EXPLICIT_ACCESS_W),
        wintypes.LPVOID,
        ctypes.POINTER(wintypes.LPVOID),
    ]
    advapi32.SetEntriesInAclW.restype = wintypes.DWORD
    advapi32.SetNamedSecurityInfoW.argtypes = [
        wintypes.LPCWSTR,
        wintypes.DWORD,
        wintypes.DWORD,
        wintypes.LPVOID,
        wintypes.LPVOID,
        wintypes.LPVOID,
        wintypes.LPVOID,
    ]
    advapi32.SetNamedSecurityInfoW.restype = wintypes.DWORD

    token = wintypes.HANDLE()
    check_bool(advapi32.OpenProcessToken(kernel32.GetCurrentProcess(), TOKEN_QUERY, ctypes.byref(token)))
    try:
        length = wintypes.DWORD(0)
        if not advapi32.GetTokenInformation(token, TokenUser, None, 0, ctypes.byref(length)):
            error = ctypes.get_last_error()
            if error != ERROR_INSUFFICIENT_BUFFER:
                raise ctypes.WinError(error) from None
        buffer = (ctypes.c_byte * length.value)()
        check_bool(
            advapi32.GetTokenInformation(
                token, TokenUser, ctypes.byref(buffer), length.value, ctypes.byref(length)
            )
        )
        user = TOKEN_USER.from_buffer(buffer)
        user_sid = user.User.Sid

        entry = EXPLICIT_ACCESS_W(
            grfAccessPermissions=FILE_ALL_ACCESS,
            grfAccessMode=SET_ACCESS,
            grfInheritance=NO_INHERITANCE,
            Trustee=TRUSTEE_W(
                pMultipleTrustee=None,
                MultipleTrusteeOperation=NO_MULTIPLE_TRUSTEE,
                TrusteeForm=TRUSTEE_IS_SID,
                TrusteeType=TRUSTEE_IS_USER,
                ptstrName=user_sid,
            ),
        )
        new_acl = wintypes.LPVOID()
        check_error(advapi32.SetEntriesInAclW(1, ctypes.byref(entry), None, ctypes.byref(new_acl)))
        try:
            check_error(
                advapi32.SetNamedSecurityInfoW(
                    path,
                    SE_FILE_OBJECT,
                    DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
                    None,
                    None,
                    new_acl,
                    None,
                )
            )
        finally:
            kernel32.LocalFree(new_acl)
    finally:
        kernel32.CloseHandle(token)


if not os.environ.get("CURSOR_API_KEY") or os.environ.get("CURSOR_SDK_CLIENT_LANGUAGE") != "rust":
    sys.exit(3)
local_store = json.loads(argument("--local-store"))
if local_store.get("type") != "jsonl" or not os.path.isabs(local_store.get("rootDir", "")):
    sys.exit(4)
startup_phase("arguments-validated")
token = uuid.uuid4().hex
token_file = os.path.join(argument("--state-root"), "fake-bridge-token")
descriptor = os.open(token_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
os.write(descriptor, token.encode())
os.close(descriptor)
os.chmod(token_file, 0o600)
startup_phase("token-created")
if os.name == "nt":
    startup_phase("windows-acl-start")
    restrict_windows_private_file(token_file)
    startup_phase("windows-acl-complete")
append_observation(os.environ.get("FAKE_BRIDGE_LOG"), str(os.getpid()))
runs = {}
store_log = os.environ.get("FAKE_BRIDGE_STORE_LOG")
send_log = os.environ.get("FAKE_BRIDGE_SEND_LOG")
gate_dir = os.environ.get("FAKE_BRIDGE_GATE_DIR")
request_log = os.environ.get("FAKE_BRIDGE_REQUEST_LOG")
delay_ms = int(os.environ.get("FAKE_BRIDGE_DELAY_MS", "0"))
callback_token = None


def record_store(body):
    if not store_log:
        return
    local = body.get("options", {}).get("local", {})
    store = local.get("store")
    append_observation(store_log, json.dumps(store, sort_keys=True))


def record_send(agent, text):
    if not send_log:
        return
    append_observation(send_log, json.dumps({"pid": os.getpid(), "agent": agent, "text": text,
                                             "callback": callback_token}))


def agent_file(agent):
    return os.path.join(local_store["rootDir"], agent + ".jsonl")


def stored_run(agent, run):
    try:
        with open(agent_file(agent)) as history_file:
            rows = [json.loads(line) for line in history_file]
    except (FileNotFoundError, json.JSONDecodeError):
        return None
    return next((row for row in reversed(rows) if row.get("run_id") == run), None)


def frame(flags, message):
    body = json.dumps(message).encode()
    return bytes([flags]) + len(body).to_bytes(4, "big") + body


def finished(agent, run, text):
    status = "RUN_LIFECYCLE_STATUS_FINISHED"
    inner = {"agentId": agent, "runId": run, "status": status, "result": text}
    return {"result": {"agentId": agent, "runId": run, "status": status, "result": inner}}


def run_status(run):
    return os.environ.get("FAKE_BRIDGE_GET_RUN_STATUS", "RUN_LIFECYCLE_STATUS_CANCELLED")


class Bridge(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *_):
        pass

    def answer(self, status, body, content_type="application/json"):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        global callback_token
        request = self.rfile.read(int(self.headers.get("Content-Length", "0")))
        if self.headers.get("Authorization") != f"Bearer {token}":
            return self.answer(401, b"{}")
        method = self.path.rsplit("/", 1)[-1]
        if request_log:
            append_observation(request_log, method)
        if method in ("Me", "ListModels"):
            if self.path != "/sdk.v1.SdkCursorService/" + method or json.loads(request or b"{}") != {}:
                return self.answer(400, b'{"message":"metadata request must be empty"}')
        if method == "Me":
            ready = os.environ.get("FAKE_BRIDGE_ME_READY")
            release = os.environ.get("FAKE_BRIDGE_ME_RELEASE")
            if ready:
                with open(ready, "w") as marker:
                    marker.write("ready")
            if release:
                while not os.path.exists(release):
                    time.sleep(0.01)
            mode = os.environ.get("FAKE_BRIDGE_ME", "ok")
            if mode == "401":
                return self.answer(401, b'{"message":"unauthorized"}')
            if mode == "403":
                return self.answer(403, b'{"message":"forbidden"}')
            if mode == "timeout":
                time.sleep(10)
            if mode == "malformed":
                return self.answer(200, b'{"user":"not-an-object"}')
            if mode == "oversize":
                return self.answer(200, b'{"user":{"profile":"' + b"x" * 65536 + b'"}}')
            return self.answer(200, b'{"user":{"userEmail":"private@example.invalid"}}')
        if method == "ListModels":
            mode = os.environ.get("FAKE_BRIDGE_MODELS", "ok")
            if mode == "401":
                return self.answer(401, b'{"message":"unauthorized"}')
            if mode == "403":
                return self.answer(403, b'{"message":"forbidden"}')
            if mode == "500":
                return self.answer(500, b'{"message":"catalog unavailable"}')
            if mode == "timeout":
                time.sleep(10)
            if mode == "malformed":
                return self.answer(200, b'{"items":[{"id":"composer-2","displayName":42}]}')
            if mode == "id_only":
                return self.answer(200, b'{"items":[{"id":"composer-2"}]}')
            if mode == "oversize":
                return self.answer(200, b'{"items":[{"id":"composer-2","displayName":"' + b"x" * 65536 + b'"}]}')
            return self.answer(200, b'{"items":[{"id":"composer-2","displayName":"Composer 2"}]}')
        if method == "Send":
            message = json.loads(request[5:])
            agent, run = message["agentId"], "run-" + uuid.uuid4().hex
            text = message["message"]["text"]
            runs[run] = {"agent": agent, "result": "done: " + text}
            try:
                with open(agent_file(agent)) as history_file:
                    history = [json.loads(line) for line in history_file]
            except FileNotFoundError:
                return self.answer(404, b'{"message":"agent not found"}')
            with open(agent_file(agent), "a") as history_file:
                history_file.write(json.dumps({"prompt": text}) + "\n")
            record_send(agent, text)
            if gate_dir:
                while not os.path.exists(os.path.join(gate_dir, text.split("-", 1)[0])):
                    time.sleep(0.01)
            if "hang" in text and "unknown" not in text:
                self.send_response(200)
                self.send_header("Content-Type", "application/connect+json")
                self.send_header("Transfer-Encoding", "chunked")
                self.send_header("Connection", "close")
                self.end_headers()
                initial = frame(0, {"sdkMessage": {"type": "status", "message": {
                    "agentId": agent, "runId": run, "status": "RUN_LIFECYCLE_STATUS_RUNNING"}}})
                self.wfile.write(f"{len(initial):X}\r\n".encode() + initial + b"\r\n")
                self.wfile.flush()
                while (runs.get(run) or {}).get("status") != "RUN_LIFECYCLE_STATUS_CANCELLED":
                    time.sleep(0.01)
                self.wfile.write(b"0\r\n\r\n")
                self.wfile.flush()
                return
            if "hang" in text:
                time.sleep(3600)
            if delay_ms:
                time.sleep(delay_ms / 1000)
            answer = "done: " + text
            if text == "recall":
                answer = "remembered: " + next(row["prompt"] for row in reversed(history) if "prompt" in row)
            runs[run]["result"] = answer
            with open(agent_file(agent), "a") as history_file:
                history_file.write(json.dumps({"run_id": run, "status": "RUN_LIFECYCLE_STATUS_FINISHED", "result": answer}) + "\n")
            runs[run]["status"] = "RUN_LIFECYCLE_STATUS_FINISHED"
            stream = (frame(0, finished(agent, run, answer))
                      + frame(0, {"done": {"agentId": agent, "runId": run}}) + frame(2, {}))
            return self.answer(200, stream, "application/connect+json")
        body = json.loads(request or b"{}")
        if method == "SetToolCallback":
            callback_token = body.get("authToken")
        if method == "ResumeAgent" and os.environ.get("FAKE_BRIDGE_REJECT_RESUME"):
            return self.answer(409, b'{"message":"readback must not replace the active agent"}')
        if method in ("CreateAgent", "ResumeAgent"):
            record_store(body)
            if body.get("options", {}).get("local", {}).get("store") != local_store:
                return self.answer(400, b'{"message":"private JSONL store mismatch"}')
            agent = body.get("agentId") or "agent-" + uuid.uuid4().hex
            if method == "CreateAgent":
                descriptor = os.open(agent_file(agent), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                os.write(descriptor, b'{"created":true}\n')
                os.close(descriptor)
            elif not os.path.isfile(agent_file(agent)):
                return self.answer(404, b'{"message":"agent not found in private store"}')
            return self.answer(200, json.dumps({"agentId": agent}).encode())
        if method == "CancelRun":
            run = runs.get(body.get("runId"))
            if run:
                run["status"] = "RUN_LIFECYCLE_STATUS_CANCELLED"
                with open(agent_file(run["agent"]), "a") as history_file:
                    history_file.write(json.dumps({"run_id": body.get("runId"), "status": "RUN_LIFECYCLE_STATUS_CANCELLED"}) + "\n")
            return self.answer(200, b"{}")
        requested_agent = body.get("options", {}).get("agentId")
        stored = stored_run(requested_agent, body.get("runId")) if requested_agent else None
        snapshot = runs.get(body.get("runId")) or stored or {}
        replies = {
            "Ping": {"message": "pong"},
            "GetVersion": {"protocolVersion": "sdk.v1"},
            "GetRun": {"run": {"agentId": snapshot.get("agent", requested_agent),
                               "runId": body.get("runId"),
                               "status": snapshot.get("status", run_status(body.get("runId"))),
                               "result": snapshot.get("result", os.environ.get("FAKE_BRIDGE_GET_RUN_RESULT"))}},
        }
        if method == "Shutdown":
            threading.Timer(0.1, os._exit, [0]).start()
        self.answer(200, json.dumps(replies.get(method, {})).encode())


server = ThreadingHTTPServer(("127.0.0.1", 0), Bridge)
startup_phase("server-bound")
server.daemon_threads = True
time.sleep(int(os.environ.get("FAKE_BRIDGE_STARTUP_MS", "0")) / 1000)
if os.environ.get("FAKE_BRIDGE_EXIT_BEFORE_READY"):
    sys.exit(7)
discovery = {"schemaVersion": 1, "transport": "tcp", "protocol": "connect",
             "url": f"http://127.0.0.1:{server.server_address[1]}", "authTokenFile": token_file}
print("cursor-sdk-bridge ready " + json.dumps(discovery), file=sys.stderr, flush=True)
server.serve_forever()
