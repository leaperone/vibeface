+class OwnedMutableBuffer final : public jsi::MutableBuffer {
+public:
+  explicit OwnedMutableBuffer(size_t len)
+      : bytes(new uint8_t[len]), len(len) {}
+  ~OwnedMutableBuffer() override {
+    // Volatile stores keep erasure of secret-bearing copies from being optimized out.
+    volatile uint8_t *data = bytes.get();
+    for (size_t i = 0; i < len; ++i) data[i] = 0;
+  }
+  size_t size() const override { return len; }
+  uint8_t *data() override { return bytes.get(); }
+
+private:
+  std::unique_ptr<uint8_t[]> bytes;
+  size_t len;
+};
