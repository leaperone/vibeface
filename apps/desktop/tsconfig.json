{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "electron": ["./electron.d.ts"]
    }
  },
  "include": ["electron.d.ts", "src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
