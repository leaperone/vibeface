#!/usr/bin/env python3
"""A controlled stand-in for `claude -p --input-format stream-json --output-format stream-json`.

It speaks the frames the Node reads and writes a transcript the way Claude Code does, under
`$CLAUDE_CONFIG_DIR/projects/<cwd slug>/<session>.jsonl`. The first word of a prompt picks how
the turn goes:

  hang    replies, then waits until it is interrupted
  vanish  records the finished turn in the transcript, then sleeps without reporting it
  die     records the prompt, then exits before the turn ends
  fail    ends the turn with an API error
  abort   ends the turn as aborted though nobody asked it to stop
  other   replies, runs one Bash tool, and answers "done: <prompt>"

Every argument list and stdin frame is appended to `$FAKE_CLAUDE_LOG` as one JSON line.
"""
import json
import os
import re
import queue
import threading
import sys
import time
import uuid

if sys.argv[1:] == ["auth", "status", "--json"]:
    print(json.dumps({"loggedIn": True}))
    sys.exit(0)

INPUT = queue.Queue()
INPUT_EOF = object()


def collect_input():
    for line in sys.stdin:
        INPUT.put(line)
    INPUT.put(INPUT_EOF)


def input_lines():
    while True:
        line = INPUT.get()
        if line is INPUT_EOF:
            INPUT.put(INPUT_EOF)
            return
        yield line


threading.Thread(target=collect_input, daemon=True).start()

LOG = os.environ.get("FAKE_CLAUDE_LOG")
GATE_DIR = os.environ.get("FAKE_CLAUDE_GATE_DIR")
GATE_RELEASE = os.environ.get("FAKE_CLAUDE_GATE_RELEASE")
RESULT_GATE = os.environ.get("FAKE_CLAUDE_RESULT_GATE")
DELAY_RESULT = [False]


def append_observation(path, value):
    if not path:
        return
    data = (value + "\n").encode("utf-8")
    if os.name != "nt":
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        try:
            if os.write(descriptor, data) != len(data):
                raise OSError("incomplete observation append")
        finally:
            os.close(descriptor)
        return
    import ctypes
    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
    kernel.CreateFileW.argtypes = [ctypes.c_wchar_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_void_p]
    kernel.CreateFileW.restype = ctypes.c_void_p
    kernel.WriteFile.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ctypes.c_ulong), ctypes.c_void_p]
    kernel.CloseHandle.argtypes = [ctypes.c_void_p]
    handle = kernel.CreateFileW(path, 0x0004, 0x0007, None, 4, 0x80, None)
    if handle == ctypes.c_void_p(-1).value:
        raise ctypes.WinError(ctypes.get_last_error())
    try:
        written = ctypes.c_ulong()
        buffer = ctypes.create_string_buffer(data)
        if not kernel.WriteFile(handle, buffer, len(data), ctypes.byref(written), None):
            raise ctypes.WinError(ctypes.get_last_error())
        if written.value != len(data):
            raise OSError("incomplete observation append")
    finally:
        kernel.CloseHandle(handle)


def log(entry):
    if LOG:
        append_observation(LOG, json.dumps(entry))


def emit(frame):
    sys.stdout.write(json.dumps(frame) + "\n")
    sys.stdout.flush()


def option(name):
    args = sys.argv[1:]
    return args[args.index(name) + 1] if name in args else None


guide = option("--append-system-prompt-file")
guide_text = None
guide_private = None
if guide:
    with open(guide) as file:
        guide_text = file.read()
    if os.name != "nt":
        guide_private = os.stat(guide).st_mode & 0o077 == 0
log({
    "argv": sys.argv[1:],
    "cwd": os.getcwd(),
    "guide": guide_text,
    "guide_private": guide_private,
    "env": {name: name in os.environ for name in
            ("VIBEFACE_TOOL_TOKEN", "VIBEFACE_NODE_URL", "CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT", "FAKE_MARK")},
})
resumed = option("--resume")
session = resumed or option("--session-id")
home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
project = os.path.join(home, "projects", re.sub(r"[^A-Za-z0-9]", "-", os.path.realpath(os.getcwd())))
transcript = os.path.join(project, f"{session}.jsonl")
if resumed and not os.path.exists(transcript):
    sys.stderr.write(f"No conversation found with session ID: {session}\n")
    sys.exit(1)
if not resumed and os.path.exists(transcript):
    sys.stderr.write(f"Error: Session ID {session} is already in use.\n")
    sys.exit(1)
os.makedirs(project, exist_ok=True)
parent = None


def record(entry):
    global parent
    entry.update({"uuid": entry.get("uuid") or str(uuid.uuid4()), "parentUuid": parent,
                  "sessionId": session, "cwd": os.getcwd(), "isSidechain": False})
    parent = entry["uuid"]
    with open(transcript, "a") as handle:
        handle.write(json.dumps(entry) + "\n")


def assistant(message_id, block, stop):
    frame_uuid = str(uuid.uuid4())
    emit({"type": "assistant", "message": {"id": message_id, "role": "assistant", "content": [block],
          "stop_reason": None}, "parent_tool_use_id": None, "session_id": session, "uuid": frame_uuid})
    record({"type": "assistant", "uuid": frame_uuid, "message": {"id": message_id, "role": "assistant",
            "content": [block], "stop_reason": stop}})


def result(subtype, is_error, text, reason, **extra):
    if DELAY_RESULT[0] and RESULT_GATE:
        open(RESULT_GATE + ".waiting", "w").close()
        while not os.path.exists(RESULT_GATE):
            time.sleep(0.01)
    emit({"type": "result", "subtype": subtype, "is_error": is_error, "result": text, "session_id": session,
          "stop_reason": None, "terminal_reason": reason, "num_turns": 1, "uuid": str(uuid.uuid4()), **extra})


def prompt_of(message):
    content = message.get("content")
    if isinstance(content, str):
        return content
    return " ".join(block.get("text", "") for block in content or [] if block.get("type") == "text")


def answer_control(frame):
    emit({"type": "control_response", "response": {"subtype": "success", "request_id": frame.get("request_id"),
          "response": {"still_queued": []}}})


def accept_steer(frame):
    log({"stdin": "user", "uuid": frame.get("uuid"), "message": frame["message"]})
    record({"type": "user", "uuid": frame.get("uuid"), "message": frame["message"]})
    emit({**frame, "session_id": session, "isReplay": True})


def gated():
    if not GATE_DIR or not GATE_RELEASE:
        return False
    os.makedirs(GATE_DIR, exist_ok=True)
    open(os.path.join(GATE_DIR, f"{session}.started"), "w").close()
    while not os.path.exists(GATE_RELEASE):
        try:
            line = INPUT.get(timeout=0.05)
        except queue.Empty:
            continue
        if line is INPUT_EOF:
            INPUT.put(INPUT_EOF)
            return True
        control = json.loads(line)
        if control.get("type") == "user":
            accept_steer(control)
            continue
        log({"stdin": control.get("type"), "subtype": (control.get("request") or {}).get("subtype")})
        if (control.get("request") or {}).get("subtype") == "interrupt":
            answer_control(control)
            record({"type": "user", "interruptedMessageId": "msg_1",
                    "message": {"role": "user", "content": [{"type": "text", "text": "[Request interrupted by user]"}]}})
            result("error_during_execution", True, "", "aborted_streaming")
            return True
    return False


def turn(frame):
    prompt = prompt_of(frame["message"]).strip()
    mode = prompt.split()[0] if prompt else ""
    record({"type": "user", "uuid": frame.get("uuid"), "message": frame["message"]})
    emit({"type": "system", "subtype": "init", "session_id": session, "cwd": os.getcwd(),
          "model": option("--model") or "fake", "permissionMode": option("--permission-mode"), "tools": ["Bash"]})
    if gated():
        return
    if mode == "vanish":
        record({"type": "assistant", "message": {"id": "msg_v", "role": "assistant",
                "content": [{"type": "text", "text": "finished while unwatched"}], "stop_reason": "end_turn"}})
        time.sleep(3600)
    if mode == "die":
        sys.exit(3)
    if mode == "fail":
        text = "API Error: 401 Invalid API key · Please run /login"
        record({"type": "assistant", "isApiErrorMessage": True, "message": {"id": "msg_f", "role": "assistant",
                "content": [{"type": "text", "text": text}], "stop_reason": "stop_sequence"}})
        result("success", True, text, "completed")
        return
    assistant("msg_1", {"type": "text", "text": "Looking."}, "tool_use")
    if mode == "abort":
        result("error_during_execution", True, "", "aborted_tools")
        return
    if mode in ("hang", "steer", "steer-late", "steer-late-delayed"):
        steered = 0
        deferred = []
        for line in input_lines():
            control = json.loads(line)
            if control.get("type") == "user":
                if mode in ("steer-late", "steer-late-delayed"):
                    assistant("msg_initial", {"type": "text", "text": "initial finished"}, "end_turn")
                    result("success", False, "initial finished", "completed")
                    DELAY_RESULT[0] = mode == "steer-late-delayed"
                    turn(control)
                    return
                if mode == "steer":
                    deferred.append(control)
                    if len(deferred) < 3:
                        continue
                    for queued in deferred:
                        accept_steer(queued)
                    steered = len(deferred) - 1
                else:
                    accept_steer(control)
                steered += 1
                if mode == "steer" and steered == 3:
                    assistant("msg_2", {"type": "text", "text": "Got all three inputs"}, "end_turn")
                    result("success", False, "Got all three inputs", "completed")
                    return
                continue
            log({"stdin": control.get("type"), "subtype": (control.get("request") or {}).get("subtype")})
            if (control.get("request") or {}).get("subtype") == "interrupt":
                answer_control(control)
                record({"type": "user", "interruptedMessageId": "msg_1",
                        "message": {"role": "user", "content": [{"type": "text", "text": "[Request interrupted by user]"}]}})
                result("error_during_execution", True, "", "aborted_streaming")
                return
        sys.exit(0)
    assistant("msg_1", {"type": "tool_use", "id": "toolu_1", "name": "Bash", "input": {"command": "true"}}, "tool_use")
    tool_result = {"type": "tool_result", "tool_use_id": "toolu_1", "content": "", "is_error": False}
    emit({"type": "user", "message": {"role": "user", "content": [tool_result]}, "parent_tool_use_id": None,
          "session_id": session, "uuid": str(uuid.uuid4()), "tool_use_result": {"stdout": ""}})
    record({"type": "user", "message": {"role": "user", "content": [tool_result]}})
    answer = f"done: {prompt}"
    assistant("msg_2", {"type": "text", "text": answer}, "end_turn")
    result("success", False, answer, "completed")


for line in input_lines():
    frame = json.loads(line)
    log({"stdin": frame.get("type"), "uuid": frame.get("uuid"),
         "subtype": (frame.get("request") or {}).get("subtype")})
    if frame.get("type") == "user":
        turn(frame)
    elif frame.get("type") == "control_request":
        answer_control(frame)
