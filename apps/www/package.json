{
  "name": "vibeface-www",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 4173",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "build": "node --dns-result-order=ipv4first node_modules/vite/bin/vite.js build",
    "preview": "vite preview --port 4173",
    "check:static": "node scripts/check-static.mjs",
    "test:e2e": "e2e run --config e2e.config.ts",
    "test:e2e:check": "tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@vibeface/theme": "workspace:*",
    "fumadocs-core": "16.17.9",
    "fumadocs-ui": "16.17.9",
    "flexsearch": "0.8.212",
    "lucide-react": "^1.58.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^24.19.2",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "fumadocs-mdx": "15.4.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
